; TOML's render: a tree's events written as one TOML 1.0 document. This
; is a library of definitions, each named `toml-...`, which a host links
; with its own program (alchemy's `compile_sources`); its entry point is
; `toml-render`, and nothing else here is the host's to call.
;
; The profile is always-quoted, as the YAML and CSV renders' are: every
; key is a quoted key and every string a basic string, both through
; `quoted` (JSON's escapes, which TOML's basic strings read, with the
; controls TOML forbids in one written as `\uXXXX`), since alchemy cannot
; tell a bare key from one that has to be quoted. The root is the one
; table, each member on its own line as `"key" = value`; a table under a
; key is an inline table on that line, `{ "k" = v, "k2" = v2 }`, and `{}`
; when empty, since TOML 1.0 keeps an inline table to one line with no
; trailing comma; an array is `[ v, v ]`, and `[]` when empty, and may
; hold inline tables and arrays. A number is its lexeme, or as the JSON
; renderer writes it when it has none, which is how every number reaches
; a render from a parsed TOML document (so `1.0` is written as `1`), and a
; non-finite one is `inf`, `-inf` or `nan`; a boolean is `true` or
; `false`.
;
; What TOML cannot carry fails with INPUT_INVALID, saying so: a root that
; is not a table, since TOML's document is one, and a null, since TOML
; has none. The failure names the place (a root member, an inline table's
; member, an array); a member's key is the last text the render wrote
; before it.
;
; The events are a tree's: a table holds each key once. A walked value
; is one by construction; a host that streams a parse must refuse a
; member the parse repeats, since the render writes what it is given and
; TOML forbids a key defined twice.
;
; The state is the stack of open containers, one marker each, so it grows
; with a document's nesting and never with its width: `:root` for the
; root table waiting for a key, `:member` for a root member whose key is
; written and waits for its value, `:table-open` for an inline table with
; nothing written yet, `:table` for one waiting for its next key,
; `:table-member` for its member whose key is written, `:array-open` for
; an array with nothing written yet and `:array` for one waiting for its
; next item. The separators are decided by the marker, so no container
; counts its members. Once the root table ends the state is
; `[:root-done]`, and nothing may follow it. Events no tree has fail with
; INPUT_INVALID, saying so.

; The top marker, or `:none` before the root value.
def toml-top [s]
  match (count s)
    case 0 :none
    case _ (top s)

; The top container under another marker.
def toml-mark [marker s]
  push marker (pop s)

; What comes before a value whose parent is the top of s: nothing after a
; key's ` = `, a space before an array's first item and `, ` before a
; later one.
def toml-lead [s]
  match (toml-top s)
    case :member ""
    case :table-member ""
    case :array-open " "
    case :array ", "
    case _ (fail "the events hold a value where a key is due, which a tree's never do")

; A held array is opened by its first item.
def toml-entered [s]
  match (toml-top s)
    case :array-open (toml-mark :array s)
    case _ s

; A value completed under the top of s: the root table waits for its
; next key, an inline table for its next key, an array for its next item.
def toml-done [s]
  match (toml-top s)
    case :member (toml-mark :root s)
    case :table-member (toml-mark :table s)
    case _ s

; What follows a value completed under the top of s: a root member's
; line ends.
def toml-close [s]
  match (toml-top s)
    case :member "\n"
    case _ ""

def toml-number [n]
  match (number-class n)
    case :finite (scalar-text csv-options n)
    case :infinity "inf"
    case :negative-infinity "-inf"
    case :nan "nan"

; TOML has no null. The place is the top of s, where the value was due;
; the key written before a member's null is in the output already.
def toml-null [s]
  match (toml-top s)
    case :member (fail "TOML has no null: a member of the root table holds one, which TOML cannot carry")
    case :table-member (fail "TOML has no null: a member of an inline table holds one, which TOML cannot carry")
    case _ (fail "TOML has no null: an array holds one, which TOML cannot carry")

; A scalar due at the top of s: a string as a basic string, a number by
; its lexeme or its value, a boolean by its name.
def toml-scalar [value s]
  match (kind value)
    case :null (toml-null s)
    case :boolean
      match value
        case true "true"
        case false "false"
    case :number (toml-number value)
    case _ (quoted value)

; A root that is not a table: TOML's document is one.
def toml-root-scalar [value]
  match (kind value)
    case :null (fail "TOML's root is a table: the document's root is null, which TOML cannot carry")
    case :boolean (fail "TOML's root is a table: the document's root is a boolean, which TOML cannot carry")
    case :number (fail "TOML's root is a table: the document's root is a number, which TOML cannot carry")
    case _ (fail "TOML's root is a table: the document's root is a string, which TOML cannot carry")

; A key, written where the table's keys go: at the start of its own line
; at the root, after the opening brace or a comma in an inline table.
def toml-member [name s]
  match (toml-top s)
    case :root
      transition (toml-mark :member s) [(quoted name) " = "]
    case :table-open
      transition (toml-mark :table-member s) [" " (quoted name) " = "]
    case :table
      transition (toml-mark :table-member s) [", " (quoted name) " = "]
    case _ (fail "the events hold a key where a value is due, which a tree's never do")

def toml-step [s event]
  match (toml-top s)
    case :root-done (fail "the events hold more after the root table, which a tree's never do")
    case _ (toml-event s event)

def toml-event [s event]
  match event
    case object-start
      match (toml-top s)
        case :none (transition [:root] [])
        case _ (transition (push :table-open (toml-entered s)) [(toml-lead s) "{"])
    case array-start
      match (toml-top s)
        case :none (fail "TOML's root is a table: the document's root is an array, which TOML cannot carry")
        case _ (transition (push :array-open (toml-entered s)) [(toml-lead s) "["])
    case (key name) (toml-member name s)
    case (scalar value)
      match (toml-top s)
        case :none (toml-root-scalar value)
        case _
          let [s2 (toml-entered s)]
            transition (toml-done s2) [(toml-lead s) (toml-scalar value s) (toml-close s2)]
    case object-end
      match (toml-top s)
        case :root (transition [:root-done] [])
        case :table-open
          transition (toml-done (pop s)) ["}" (toml-close (pop s))]
        case :table
          transition (toml-done (pop s)) [" }" (toml-close (pop s))]
        case :member
          fail "the events end a table after a key and before its value, which a tree's never do"
        case :table-member
          fail "the events end a table after a key and before its value, which a tree's never do"
        case _
          fail "the events end a table that is not open, which a tree's never do"
    case array-end
      match (toml-top s)
        case :array-open
          transition (toml-done (pop s)) ["]" (toml-close (pop s))]
        case :array
          transition (toml-done (pop s)) [" ]" (toml-close (pop s))]
        case _
          fail "the events end an array that is not open, which a tree's never do"

def toml-finish [s]
  match (toml-top s)
    case :root-done []
    case :none (fail "the events hold no value, where a tree's hold one")
    case _ (fail "the events ended inside a container")

; The render: the tree's events in, the document's text out.
def toml-render [input]
  join ""
    scan-emit [] toml-step toml-finish (events input)
