# pkg-config for libtabnastoml (tabnas-clib-template: v1)
# Install alongside the built library; substitute @PREFIX@ at install.
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libtabnastoml
Description: toml parser (libtabnastoml) — uniform tabnas C ABI (ADR-12)
Version: @VERSION@
Libs: -L${libdir} -ltabnastoml
Cflags: -I${includedir}
